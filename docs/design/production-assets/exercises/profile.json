{
  "schemaVersion": 1,
  "localRoot": "verification/local/artwork/exercises",
  "metadataRoot": "docs/design/production-assets/exercises",
  "allowedOutputRoots": [
    "verification/local/artwork/exercises",
    "docs/design/production-assets/exercises",
    "assets/exercises"
  ],
  "authorityFiles": [
    "AGENTS.md",
    "docs/design/current/README.md",
    "docs/design/current/weekly-routines.md"
  ],
  "verificationCommands": [
    "npm run verify:design",
    "git diff --check"
  ],
  "registries": [
    {
      "key": "exercises",
      "adapter": "generic",
      "file": "docs/design/production-assets/exercises/manifest.json"
    }
  ],
  "defaults": {
    "route": "generation",
    "registry": "exercises",
    "master": {
      "destination": "assets/exercises/masters/{asset}-v{version}{suffix}",
      "minimumSize": [
        960,
        540
      ],
      "format": "PNG",
      "alpha": "transparent",
      "colorSpace": "srgb",
      "allowAssumedSrgb": true
    },
    "exports": [
      {
        "role": "runtime",
        "destination": "assets/exercises/{asset}-v{version}.webp",
        "size": [
          960,
          540
        ],
        "format": "WEBP",
        "fit": "contain",
        "focal": [
          0.5,
          0.5
        ],
        "lossless": true,
        "allowUpscale": false,
        "copies": []
      }
    ],
    "views": [
      {
        "name": "focus-narrow",
        "size": [
          256,
          144
        ],
        "unit": "dp",
        "fit": "contain",
        "focal": [
          0.5,
          0.5
        ],
        "overlayHeight": 0,
        "landmarks": []
      },
      {
        "name": "focus-wide",
        "size": [
          320,
          180
        ],
        "unit": "dp",
        "fit": "contain",
        "focal": [
          0.5,
          0.5
        ],
        "overlayHeight": 0,
        "landmarks": []
      }
    ]
  },
  "policies": {
    "individualApproval": true,
    "sequentialQueue": true,
    "statusFile": "docs/backlog.md",
    "queue": [
      "front-plank",
      "bird-dog",
      "side-plank",
      "running",
      "incline-treadmill-walking",
      "walking",
      "lat-pulldown",
      "machine-chest-press",
      "cable-face-pull",
      "dumbbell-shoulder-press",
      "machine-shoulder-press",
      "incline-hammer-curl",
      "cable-triceps-pushdown",
      "goblet-squat",
      "dumbbell-bench-press",
      "dumbbell-rdl",
      "one-arm-dumbbell-row"
    ],
    "sourcePolicy": "Current app supplies presentation tokens. Owner-supplied exercise illustration supplies style only; never inherit historical scenery or brand references.",
    "runtimeAcceptance": "Art review is separate from real-component and signed-phone acceptance."
  },
  "assets": {
    "front-plank": {},
    "bird-dog": {},
    "side-plank": {},
    "running": {},
    "incline-treadmill-walking": {},
    "walking": {},
    "lat-pulldown": {},
    "machine-chest-press": {},
    "cable-face-pull": {},
    "dumbbell-shoulder-press": {},
    "machine-shoulder-press": {},
    "incline-hammer-curl": {},
    "cable-triceps-pushdown": {},
    "goblet-squat": {},
    "dumbbell-bench-press": {},
    "dumbbell-rdl": {},
    "one-arm-dumbbell-row": {}
  }
}
