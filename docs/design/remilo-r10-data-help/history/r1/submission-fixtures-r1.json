  "proposalNotes": [
    "Restore backup replaces the existing Restore selected data label; import selection semantics stay unchanged.",
    "Preview Future time indicated/No future time indicated is a label correction, not new native eligibility.",
    "Pending reminder updates, actual observation/capability/schema display and generic Alert blocked replace broader/misleading current copy.",
    "Definitive real-bridge rejection, mounted job recovery versus process death, share/refresh request lifetime and cache cleanup remain implementation gaps.",
    "A receipt retry can lack all result counts; no invented zero totals or readiness."
  ],
  "additionalComponentStates": [
    "Preparing backup and export file-write/share-open failure",
    "Android document chooser cancellation preserves prior valid preview",
    "replacement file read failure preserves previous valid preview and copy choices",
    "valid empty backup versus lists-only backup with zero entry count",
    "many lists and 25-more reminder/series preview pagination",
    "structured rejection versus real INVALID_INPUT bridge recovery contract",
    "same-job double press and process/navigation/background lifetime",
    "future/past/paused/independent/completed/skipped imported target outcomes",
    "diagnostics initial loading/error/unsupported without futile Retry",
    "valid empty states report, unknown keys and missing fields without guessed zeros",
    "diagnostics refresh success and concurrent captured-share/newer-visible report",
    "200% English/Chinese targets/footer/OS chooser and share handoff"
  ],
  "fixtureBoundary": "Synthetic preview/results/snapshots for image review, not encoded backups, native execution, real shared files or private diagnostics. Each screen uses only its declared fixture/state; no global pool joins or continuous chronology.",
